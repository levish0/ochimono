  "components": {
    "schemas": {
      "AuthorizeRequest": {
        "type": "object",
        "properties": {
          "remember_me": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "AuthorizeResponse": {
        "type": "object",
        "required": [
          "auth_url"
        ],
        "properties": {
          "auth_url": {
            "type": "string"
          }
        }
      },
      "CompleteSignupRequest": {
        "type": "object",
        "required": [
          "pending_token",
          "handle"
        ],
        "properties": {
          "handle": {
            "type": "string"
          },
          "pending_token": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "GoogleLoginRequest": {
        "type": "object",
        "required": [
          "code",
          "state"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "user",
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "signed_in"
                ]
              },
              "user": {
                "$ref": "#/components/schemas/UserResponse"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "pending_token",
              "status"
            ],
            "properties": {
              "pending_token": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending_signup"
                ]
              }
            }
          }
        ]
      },
      "SessionResponse": {
        "type": "object",
        "required": [
          "id",
          "current",
          "created_at",
          "expires_at"
        ],
        "properties": {
